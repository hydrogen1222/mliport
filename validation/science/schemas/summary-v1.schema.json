{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "mliport.beta-validation-summary/1",
  "title": "mliport beta scientific validation summary",
  "type": "object",
  "required": [
    "schema", "suite_revision", "generated_at", "code_commit",
    "model_manifest_suite_revision", "model_profiles", "record_counts",
    "support_matrix", "cases", "environment", "problems", "harness_violations"
  ],
  "properties": {
    "schema": { "const": "mliport.beta-summary/1" },
    "suite_revision": { "type": "integer", "minimum": 1 },
    "generated_at": { "type": "string" },
    "code_commit": { "type": "string" },
    "model_manifest_suite_revision": { "type": ["integer", "null"] },
    "model_profiles": { "type": ["object", "null"] },
    "record_counts": {
      "type": "object",
      "required": ["total", "by_status"],
      "properties": {
        "total": { "type": "integer", "minimum": 0 },
        "by_status": { "type": "object" }
      }
    },
    "support_matrix": {
      "description": "engine x property support as OBSERVED from t1 records; 'not_run' and 'unsupported' are distinct states",
      "type": "object"
    },
    "cases": { "type": "object" },
    "environment": { "type": "object" },
    "problems": {
      "description": "records that failed structural validation; never dropped silently",
      "type": "array"
    },
    "harness_violations": {
      "description": "calculator identity outside the allowed mliport wrapper modules (taskbook section 47); non-empty means the suite is compromised",
      "type": "array"
    }
  }
}
