# mliport .gitignore
# Artifact categories only; no per-file names from past task books.

# Python
__pycache__/
*.py[cod]
*$py.class
*.so

# Build
build/
dist/
*.egg-info/
.eggs/
*.egg

# Virtual environments
.venv/
.venv-*/
venv/
ENV/

# Editors / OS
.idea/
.vscode/
.DS_Store
*.swp
.env

# Tool caches
.ruff_cache/
.pytest_cache/
.uv/
.hypothesis/
.coverage
.coverage.*
htmlcov/
.tox/
.mypy_cache/

# Model / checkpoint files and private structure data
*.pt
*.pth
*.model
*.lmdb
*.lmdb-lock
*.aselmdb
models/
checkpoints/
wandb/
/local-data/

# Calculation outputs and logs
*.traj
*.log
runs/
results/
/data
OUTPUT/
raw/
vasp/
resolved_config.json
bulks.pkl
config.yml

# Private research workspaces (never pushed)
/sp_crosscheck_v2/
/sp_stress_crosscheck/

# Local validation work
/.validation-work/
/.validation-cache/
/.validation-recovery/
/.validation-acceptance/

# Local development notes and transient task books
/.local-plans/
/.agent-local/
/audit-local/
/*_development_plan*.md
/*_productization_*plan*.md
/*_NOT_FOR_REPO*.md
/*_review_*.md

# Generated installer launchers
/bin/

# Local package caches / offline install sources
/packages/
/mliport/uv.lock
/uv.lock
