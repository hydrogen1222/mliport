# Calculation output artifacts
results/
# Private development plans & notes (not project documentation)
/.agent-local/
/.local-plans/
# Pre-rename local-only plans/reviews: kept ignored so the old namespace can
# never leak a transient audit document into the repository.
/mlipx_*development_plan*.md
/mlipx_*NOT_FOR_REPO*.md
/mlipx_review_*.md
/mlipx_analysis_*.md
# Local wheelhouse / offline install sources
/packages/
/audit-local/
/*_NOT_FOR_REPO_*.md
/*_development_plan*.md
/mliport_analysis_v2_unfreeze_development_plan.md
/mliport_analysis_v2_final_transport_hardening_plan.md
# Private structure / model files
LGPS*

# Per-installation launcher wrappers (generated by the installer)
/bin/
# Accidental uv lockfiles inside the package dir (no workspace lock)
/mliport/uv.lock
/uv.lock
# Beta scientific validation working data (taskbook section 9)
/.validation-work/
/.validation-cache/
